<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_activated="true">
        <inset
            android:insetLeft="4dp"
            android:insetTop="4dp"
            android:insetRight="4dp"
            android:insetBottom="4dp">
            <shape android:shape="oval">
                <solid android:color="@color/overlayRuntimeMenuButtonPressed" />
                <stroke
                    android:width="2dp"
                    android:color="@color/overlayViewAccentPrimary" />
            </shape>
        </inset>
    </item>

    <item android:state_pressed="true">
        <inset
            android:insetLeft="4dp"
            android:insetTop="4dp"
            android:insetRight="4dp"
            android:insetBottom="4dp">
            <shape android:shape="oval">
                <solid android:color="@color/overlayRuntimeMenuButtonPressed" />
                <stroke
                    android:width="1dp"
                    android:color="@color/overlayViewPrimary" />
            </shape>
        </inset>
    </item>

    <item>
        <inset
            android:insetLeft="4dp"
            android:insetTop="4dp"
            android:insetRight="4dp"
            android:insetBottom="4dp">
            <shape android:shape="oval">
                <solid android:color="@color/overlayRuntimeMenuBackground" />
                <stroke
                    android:width="1dp"
                    android:color="#66FFFFFF" />
            </shape>
        </inset>
    </item>
</selector>
