<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    style="@style/AppTheme.Dialog.BackgroundLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:minHeight="@dimen/bottom_sheet_min_height"
    android:orientation="vertical">

    <include android:id="@+id/layout_top_bar"
        layout="@layout/include_dialog_navigation_top_bar" />

    <include android:id="@+id/layout_loadable_list"
        layout="@layout/include_loadable_list"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="@dimen/margin_vertical_default"
        android:background="@color/listBackground" />

    <!-- Fixed footer stays visible while the model list scrolls. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="@dimen/margin_horizontal_default"
        android:paddingVertical="@dimen/margin_vertical_small"
        android:orientation="vertical"
        android:background="?attr/colorSurfaceContainerLow">

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/text_selected_alphabet"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:accessibilityLiveRegion="polite"
            android:textAppearance="?attr/textAppearanceBodyMedium" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/button_confirm_alphabet"
            style="@style/Widget.Material3.Button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="56dp"
            android:layout_marginTop="@dimen/margin_vertical_small"
            android:enabled="false"
            android:textStyle="bold"
            android:text="@string/alphabet_selection_confirm"
            app:icon="@drawable/ic_confirm"
            app:iconGravity="textStart" />
    </LinearLayout>
</LinearLayout>
