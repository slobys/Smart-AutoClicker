<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:animateLayoutChanges="false">

    <androidx.cardview.widget.CardView
        android:id="@+id/menu_background"
        style="@style/AppTheme.Overlay.FloatingMenu.RuntimeCard"
        android:animateLayoutChanges="true"
        tools:viewBindingIgnore="true">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/menu_content"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:animateLayoutChanges="true">

            <ImageView
                android:id="@+id/error_badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/margin_vertical_default"
                android:layout_marginEnd="@dimen/margin_horizontal_small"
                app:layout_constraintEnd_toEndOf="@id/menu_items"
                app:layout_constraintTop_toTopOf="@id/menu_items"
                android:src="@drawable/ic_badge_error"
                android:scaleType="fitCenter"
                android:visibility="gone"
                tools:visibility="visible"
                tools:ignore="ContentDescription" />

            <LinearLayout
                android:id="@+id/menu_items"
                style="@style/AppTheme.Overlay.FloatingMenu.RuntimeLayoutButtons"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@id/layout_debug"
                android:animateLayoutChanges="true">

                <ImageButton
                    android:id="@+id/btn_play"
                    style="@style/AppTheme.Overlay.FloatingMenu.RuntimeButton"
                    android:src="@drawable/ic_play_arrow"
                    android:contentDescription="@string/content_desc_play_pause_scenario" />

                <ImageButton
                    android:id="@+id/btn_stop"
                    style="@style/AppTheme.Overlay.FloatingMenu.RuntimeButton"
                    android:src="@drawable/ic_stop"
                    android:contentDescription="@string/content_desc_stop_clicker" />

                <ImageButton
                    android:id="@+id/btn_switch_scenario"
                    style="@style/AppTheme.Overlay.FloatingMenu.RuntimeButton"
                    android:src="@drawable/ic_scenario_switcher"
                    android:contentDescription="@string/content_desc_switch_scenario" />

                <ImageButton
                    android:id="@+id/btn_click_list"
                    style="@style/AppTheme.Overlay.FloatingMenu.RuntimeButton"
                    android:src="@drawable/ic_settings_filled"
                    android:contentDescription="@string/content_desc_open_event_list" />

                <ImageButton
                    android:id="@+id/btn_move"
                    style="@style/AppTheme.Overlay.FloatingMenu.RuntimeButton"
                    android:src="@drawable/ic_move"
                    android:contentDescription="@string/content_desc_move_menu" />

                <ImageButton
                    android:id="@id/btn_collapse_menu"
                    style="@style/AppTheme.Overlay.FloatingMenu.RuntimeLauncherButton"
                    android:src="@drawable/ic_overlay_menu_toggle"
                    android:contentDescription="@string/content_desc_collapse_overlay_menu" />

            </LinearLayout>

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/layout_debug"
                android:layout_width="@dimen/overlay_debug_panel_width"
                android:layout_height="@dimen/overlay_debug_panel_height"
                android:visibility="gone"
                app:layout_constraintStart_toEndOf="@id/menu_items"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                tools:visibility="visible">

                <View
                    android:id="@+id/separator_start"
                    android:layout_width="2dp"
                    android:layout_height="match_parent"
                    android:background="@android:drawable/divider_horizontal_bright"
                    android:backgroundTint="@color/overlayViewPrimary"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"/>

                <TextView
                    android:id="@+id/debug_event_name"
                    style="@style/AppTheme.TextAppearance.DebugOverlayText"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="@dimen/margin_horizontal_mini"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:gravity="center_vertical"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintBottom_toTopOf="@id/separator_1"
                    app:layout_constraintVertical_chainStyle="spread"
                    app:drawableTint="@color/overlayMenuButtons"
                    android:drawablePadding="@dimen/margin_horizontal_small"
                    tools:text="@string/default_event_name"
                    tools:drawableStart="@drawable/ic_condition" />

                <View
                    android:id="@+id/separator_1"
                    android:layout_width="match_parent"
                    android:layout_height="2dp"
                    app:layout_constraintTop_toBottomOf="@id/debug_event_name"
                    app:layout_constraintBottom_toTopOf="@id/debug_event_fulfilled_count"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    android:background="@android:drawable/divider_horizontal_bright"
                    android:backgroundTint="@color/overlayViewPrimary" />

                <TextView
                    android:id="@+id/debug_event_fulfilled_count"
                    style="@style/AppTheme.TextAppearance.DebugOverlayText.Small"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="@dimen/margin_horizontal_mini"
                    android:gravity="center_vertical"
                    android:maxLines="1"
                    android:ellipsize="end"
                    app:layout_constraintTop_toBottomOf="@id/separator_1"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toStartOf="@id/separator_3"
                    app:layout_constraintBottom_toTopOf="@id/separator_2"
                    android:drawablePadding="@dimen/margin_horizontal_mini"
                    app:drawableStartCompat="@drawable/ic_confirm"
                    app:drawableTint="@color/overlayMenuButtons"
                    tools:text="42"/>

                <View
                    android:id="@+id/separator_3"
                    android:layout_width="2dp"
                    android:layout_height="0dp"
                    app:layout_constraintTop_toBottomOf="@id/separator_1"
                    app:layout_constraintBottom_toTopOf="@id/separator_2"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintHorizontal_bias="0.65"
                    android:background="@android:drawable/divider_horizontal_bright"
                    android:backgroundTint="@color/overlayViewPrimary" />

                <TextView
                    android:id="@+id/debug_event_condition_compute_time"
                    style="@style/AppTheme.TextAppearance.DebugOverlayText.Small"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="@dimen/margin_horizontal_mini"
                    android:gravity="center_vertical"
                    android:maxLines="1"
                    android:ellipsize="end"
                    app:layout_constraintTop_toBottomOf="@id/separator_1"
                    app:layout_constraintStart_toEndOf="@id/separator_3"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintBottom_toTopOf="@id/separator_2"
                    android:drawablePadding="@dimen/margin_horizontal_mini"
                    app:drawableStartCompat="@drawable/ic_duration"
                    app:drawableTint="@color/overlayMenuButtons"
                    tools:text="142ms"/>

                <View
                    android:id="@+id/separator_2"
                    android:layout_width="match_parent"
                    android:layout_height="2dp"
                    app:layout_constraintTop_toBottomOf="@id/debug_event_fulfilled_count"
                    app:layout_constraintBottom_toTopOf="@id/action_list"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    android:background="@android:drawable/divider_horizontal_bright"
                    android:backgroundTint="@color/overlayViewPrimary" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/action_list"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="@dimen/margin_horizontal_mini"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toStartOf="@id/separator_debug_controls"
                    app:layout_constraintTop_toBottomOf="@id/separator_2"
                    app:layout_constraintBottom_toBottomOf="parent"
                    android:orientation="horizontal"
                    android:scrollbars="none"
                    app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                    tools:listitem="@layout/item_live_debugging_action"
                    tools:itemCount="3"/>

                <View
                    android:id="@+id/separator_debug_controls"
                    android:layout_width="2dp"
                    android:layout_height="0dp"
                    android:layout_marginVertical="2dp"
                    android:background="@android:drawable/divider_horizontal_bright"
                    android:backgroundTint="@color/overlayViewPrimary"
                    app:layout_constraintTop_toBottomOf="@id/separator_2"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toStartOf="@id/btn_debug_pause_resume" />

                <ImageButton
                    android:id="@+id/btn_debug_pause_resume"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="@drawable/bg_overlay_runtime_button"
                    android:padding="14dp"
                    android:scaleType="centerInside"
                    android:src="@drawable/ic_debug_pause"
                    app:tint="@color/overlayQuickActionPause"
                    android:contentDescription="@string/content_desc_debug_pause_next_event"
                    app:layout_constraintTop_toBottomOf="@id/separator_2"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toStartOf="@id/btn_debug_step" />

                <ImageButton
                    android:id="@+id/btn_debug_step"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="@drawable/bg_overlay_runtime_button"
                    android:padding="14dp"
                    android:scaleType="centerInside"
                    android:src="@drawable/ic_debug_step"
                    app:tint="@color/overlayQuickActionPositive"
                    android:contentDescription="@string/content_desc_debug_step"
                    app:layout_constraintTop_toBottomOf="@id/separator_2"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent" />

            </androidx.constraintlayout.widget.ConstraintLayout>

            <!--
                Compact runtime controls used when live debugging is disabled.
                The buttons form a small fan around the edge launcher. MainMenu mirrors this
                container when the launcher is docked on the right side of the screen.
            -->
            <FrameLayout
                android:id="@+id/layout_quick_controls"
                android:layout_width="@dimen/overlay_quick_controls_width"
                android:layout_height="@dimen/overlay_quick_controls_height"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:visibility="gone"
                app:layout_constraintStart_toEndOf="@id/menu_items"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                tools:visibility="visible">

                <ImageButton
                    android:id="@+id/btn_quick_step"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_marginStart="4dp"
                    android:layout_marginTop="0dp"
                    android:background="@drawable/bg_overlay_quick_button"
                    android:elevation="6dp"
                    android:padding="15dp"
                    android:scaleType="centerInside"
                    android:src="@drawable/ic_debug_step"
                    app:tint="@color/overlayQuickActionPositive"
                    android:contentDescription="@string/content_desc_debug_step" />

                <ImageButton
                    android:id="@+id/btn_quick_switch_scenario"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_marginStart="44dp"
                    android:layout_marginTop="28dp"
                    android:background="@drawable/bg_overlay_quick_button"
                    android:elevation="6dp"
                    android:padding="15dp"
                    android:scaleType="centerInside"
                    android:src="@drawable/ic_scenario_switcher"
                    app:tint="@color/overlayQuickActionSwitch"
                    android:contentDescription="@string/content_desc_switch_scenario" />

                <ImageButton
                    android:id="@+id/btn_quick_pause_resume"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_marginStart="64dp"
                    android:layout_marginTop="64dp"
                    android:background="@drawable/bg_overlay_quick_button"
                    android:elevation="8dp"
                    android:padding="15dp"
                    android:scaleType="centerInside"
                    android:src="@drawable/ic_debug_pause"
                    app:tint="@color/overlayQuickActionPause"
                    android:contentDescription="@string/content_desc_debug_pause_next_event" />

                <ImageButton
                    android:id="@+id/btn_quick_stop"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_marginStart="44dp"
                    android:layout_marginTop="100dp"
                    android:background="@drawable/bg_overlay_quick_button"
                    android:elevation="6dp"
                    android:padding="15dp"
                    android:scaleType="centerInside"
                    android:src="@drawable/ic_stop"
                    app:tint="@color/overlayQuickActionStop"
                    android:contentDescription="@string/content_desc_stop_clicker" />

                <ImageButton
                    android:id="@+id/btn_quick_open_menu"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_marginStart="4dp"
                    android:layout_marginTop="128dp"
                    android:background="@drawable/bg_overlay_quick_button"
                    android:elevation="6dp"
                    android:padding="15dp"
                    android:scaleType="centerInside"
                    android:src="@drawable/ic_quick_open_menu"
                    app:tint="@color/overlayQuickActionMenu"
                    android:contentDescription="@string/content_desc_quick_open_full_menu" />

            </FrameLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>

    </androidx.cardview.widget.CardView>
</FrameLayout>
