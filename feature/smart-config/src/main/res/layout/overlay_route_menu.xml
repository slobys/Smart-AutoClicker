<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content" android:layout_height="wrap_content">
    <androidx.cardview.widget.CardView android:id="@+id/menu_background"
        style="@style/AppTheme.Overlay.FloatingMenu.CardView">
        <LinearLayout android:layout_width="280dp" android:layout_height="wrap_content"
            android:orientation="vertical">
            <FrameLayout android:layout_width="match_parent" android:layout_height="96dp">
                <TextView android:id="@+id/route_status" android:layout_width="match_parent"
                    android:layout_height="match_parent" android:padding="12dp" android:textSize="14sp"
                    android:textColor="#FFFFFF" android:gravity="center_vertical" android:maxLines="4"
                    android:accessibilityLiveRegion="polite" android:text="@string/route_message_preparing" />
                <View android:id="@+id/route_heartbeat" android:layout_width="6dp" android:layout_height="6dp"
                    android:layout_gravity="top|end" android:layout_margin="4dp"
                    android:background="@drawable/route_heartbeat" android:importantForAccessibility="no" />
            </FrameLayout>
            <LinearLayout android:id="@+id/menu_items" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:orientation="horizontal">
                <Button android:id="@+id/route_pause" android:layout_width="0dp" android:layout_weight="1"
                    android:layout_height="48dp" android:text="@string/route_pause" android:textSize="13sp" />
                <Button android:id="@+id/route_finish" android:layout_width="0dp" android:layout_weight="1"
                    android:layout_height="48dp" android:text="@string/route_finish" android:textSize="13sp" />
                <ImageButton android:id="@+id/btn_move" android:layout_width="48dp" android:layout_height="48dp"
                    android:background="?attr/selectableItemBackgroundBorderless" android:src="@drawable/ic_move"
                    app:tint="#FFFFFF" android:padding="12dp" android:contentDescription="@string/route_move" />
            </LinearLayout>
        </LinearLayout>
    </androidx.cardview.widget.CardView>
</FrameLayout>
