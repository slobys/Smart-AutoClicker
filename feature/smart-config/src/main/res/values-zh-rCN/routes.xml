<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools" tools:ignore="MissingTranslation">
    <string name="routes_title">路线录制与回放（实验功能）</string>
    <string name="routes_desc">读取地图坐标记录路线，下次沿路线移动</string>
    <string name="route_help">适用于显示整数 X/Y 坐标、视角固定的地图。不是录屏，也不是录手指操作。请保持视角、移速和分辨率不变，先停止普通场景。路线单独保存在本机，暂不包含在场景备份中。</string>
    <string name="route_new">新建路线</string>
    <string name="route_name">路线名称</string>
    <string name="route_empty">暂无已保存路线</string>
    <string name="route_saved">已保存路线（点击载入）</string>
    <string name="route_setup">1．框选坐标与地图标记</string>
    <string name="route_setup_help">X 框只包含横坐标数字，Y 框只包含纵坐标数字；预留位数变化空间，不要包含逗号或另一个坐标。地图标记请选择固定的地图名称或图标。悬浮条不要挡住识别区域。</string>
    <string name="route_x">框选 X 数字</string>
    <string name="route_y">框选 Y 数字</string>
    <string name="route_map">框选地图标记</string>
    <string name="route_capture">截取地图标记</string>
    <string name="route_selected">已设置：%1$s</string>
    <string name="route_pending">未设置</string>
    <string name="route_control">2．移动方式与方向校准</string>
    <string name="route_ground">点击地面</string>
    <string name="route_joystick">摇杆短拖动</string>
    <string name="route_anchor">选择角色脚下／摇杆中心</string>
    <string name="route_calibration_help">角色先站稳。选旁边一处无遮挡地面，再点“执行校准 A”：这会让角色移动一次。B 选择另一方向（尽量与 A 垂直）。点击地面模式要求镜头跟随角色、脚下位置始终在锚点；镜头或移速改变后需重新校准。</string>
    <string name="route_target_a">选择校准 A 目标</string>
    <string name="route_target_b">选择校准 B 目标</string>
    <string name="route_calibrate_a">执行校准 A（会移动）</string>
    <string name="route_calibrate_b">执行校准 B（会移动）</string>
    <string name="route_calibrated">两个方向校准通过</string>
    <string name="route_calibration_pending">需要完成两个不同方向的校准</string>
    <string name="route_actions">3．录制与回放</string>
    <string name="route_preview">测试坐标（不会移动）</string>
    <string name="route_record">开始录制新路线</string>
    <string name="route_record_help">站在起点开始录制，然后正常走路，到终点点“结束”。重新录制会创建新路线，不覆盖旧路线。每 5 秒存草稿，中断草稿不能回放。回放前请回到录制起点并站稳。</string>
    <string name="route_replay">开始回放</string>
    <string name="route_save">保存配置</string>
    <string name="route_delete">删除当前路线</string>
    <string name="route_delete_confirm">确定删除这条路线？删除后无法恢复。</string>
    <string name="route_summary">%1$d 个路径点 · %2$s</string>
