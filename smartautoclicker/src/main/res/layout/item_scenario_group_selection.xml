<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:clickable="true"
    android:focusable="true"
    android:minHeight="64dp"
    android:paddingHorizontal="8dp"
    android:paddingVertical="6dp">

    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/scenario_type"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:contentDescription="@null"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:srcCompat="@drawable/ic_smart" />

    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/scenario_name"
        style="@style/AppTheme.TextAppearance.BodyLarge"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:maxLines="1"
        app:layout_constraintEnd_toStartOf="@id/group_scenario_checkbox"
        app:layout_constraintStart_toEndOf="@id/scenario_type"
        app:layout_constraintTop_toTopOf="parent"
        tools:text="经验环" />

    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/current_group"
        style="@style/AppTheme.TextAppearance.Body"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:maxLines="1"
        app:drawableLeftCompat="@drawable/ic_folder"
        android:drawablePadding="6dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@id/group_scenario_checkbox"
        app:layout_constraintStart_toStartOf="@id/scenario_name"
        app:layout_constraintTop_toBottomOf="@id/scenario_name"
        tools:text="未分组" />

    <com.google.android.material.checkbox.MaterialCheckBox
        android:id="@+id/group_scenario_checkbox"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:checked="true" />

</androidx.constraintlayout.widget.ConstraintLayout>
